+# Build native TableGen tools required by the cross build of LLVM/Clang.
+FROM toolchain AS build-llvm-native-tools
+WORKDIR /llvm-native
+RUN cmake -G Ninja \
+        -DCMAKE_BUILD_TYPE=Release \
+        -DLLVM_ENABLE_PROJECTS=clang \
+        -DLLVM_ENABLE_TERMINFO=OFF \
+        -DLLVM_ENABLE_LIBEDIT=OFF \
+        -DLLVM_ENABLE_ZLIB=OFF \
+        -DLLVM_ENABLE_ZSTD=OFF \
+        -DLLVM_INCLUDE_BENCHMARKS=OFF \
+        -DLLVM_INCLUDE_EXAMPLES=OFF \
+        -DLLVM_INCLUDE_TESTS=OFF \
+        /llvm-project-$LLVM_VERSION/llvm \
+ && ninja llvm-tblgen clang-tblgen \
+ && mkdir -p /llvm-native-tools/bin \
+ && cp bin/llvm-tblgen bin/clang-tblgen /llvm-native-tools/bin/
+
+# Cross-build the Windows-hosted Clang and LLD drivers. GCC remains a build
+# dependency and runtime provider only; its drivers are removed when packaging.
+FROM toolchain AS build-clang
+COPY --from=build-llvm-native-tools /llvm-native-tools/ /llvm-native-tools/
+WORKDIR /llvm-clang
+RUN cmake -G Ninja \
+        -DCMAKE_BUILD_TYPE=MinSizeRel \
+        -DCMAKE_SYSTEM_NAME=Windows \
+        -DCMAKE_C_COMPILER=$ARCH-gcc \
+        -DCMAKE_CXX_COMPILER=$ARCH-g++ \
+        -DCMAKE_RC_COMPILER=$ARCH-windres \
+        -DCMAKE_INSTALL_PREFIX=$GCC_PREFIX \
+        -DCMAKE_EXE_LINKER_FLAGS="-static -static-libgcc -static-libstdc++ -s" \
+        -DLLVM_HOST_TRIPLE=x86_64-w64-windows-gnu \
+        -DLLVM_DEFAULT_TARGET_TRIPLE=x86_64-w64-windows-gnu \
+        -DLLVM_NATIVE_TOOL_DIR=/llvm-native-tools/bin \
+        -DLLVM_TARGETS_TO_BUILD=X86 \
+        -DLLVM_PARALLEL_LINK_JOBS=1 \
+        -DLLVM_ENABLE_PROJECTS="clang;lld" \
+        -DLLVM_ENABLE_TERMINFO=OFF \
+        -DLLVM_ENABLE_LIBEDIT=OFF \
+        -DLLVM_ENABLE_ZLIB=OFF \
+        -DLLVM_ENABLE_ZSTD=OFF \
+        -DLLVM_ENABLE_LIBXML2=OFF \
+        -DLLVM_ENABLE_CURL=OFF \
+        -DLLVM_INCLUDE_BENCHMARKS=OFF \
+        -DLLVM_INCLUDE_EXAMPLES=OFF \
+        -DLLVM_INCLUDE_TESTS=OFF \
+        /llvm-project-$LLVM_VERSION/llvm \
+ && ninja \
+ && ninja install \
+ && mkdir -p /artifacts/clang$GCC_PREFIX/bin /artifacts/clang$GCC_PREFIX/lib \
+ && cp -a $GCC_PREFIX/lib/clang /artifacts/clang$GCC_PREFIX/lib/ \
+ && for tool in clang clang++ ld.lld lld-link llvm-ar llvm-ranlib llvm-nm llvm-objcopy llvm-strip; do \
+        cp $GCC_PREFIX/bin/$tool.exe /artifacts/clang$GCC_PREFIX/bin/; \
+    done
+
 # Build Ctags independently from the common toolchain.
 FROM toolchain AS build-ctags
 COPY src/SHA256SUMS.ctags $PREFIX/src/
